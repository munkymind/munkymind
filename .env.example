# Required — your LLM/embedding API keys
# One key is enough: OpenAI covers embeddings AND answers (set MM_LLM_PROVIDER=openai in the wizard).
# Add ANTHROPIC_API_KEY only if you want Claude for answers. For fully local, use Ollama and no key.
# Your own key: your instance calls OpenAI directly and OpenAI bills you (prepaid credit; typically cents).
# Tip: use a dedicated OpenAI project with a monthly budget. Or use Ollama for free, fully local runs.
OPENAI_API_KEY=sk-...
# Optional (leave empty unless you want Claude for answers). Keep comments on their own line:
# Docker Compose reads `KEY=   # note` as the value "# note".
ANTHROPIC_API_KEY=

# Optional — override defaults
MM_LLM_PROVIDER=anthropic        # anthropic | openai | ollama
MM_EMBED_PROVIDER=openai         # openai | ollama
MM_USER_ID=default               # user ID for MCP sidecar — set to your username
MM_NOTES_DIR=./notes             # folder of notes to ingest (mounted at /notes)
# Set to "plain" to turn the jokes off (plain-language messages only).
MM_VOICE=
# Re-index changed notes automatically every N seconds (0 = off)
MM_SYNC_INTERVAL=300
API_PORT=8000
# Address of the API as your browser sees it, for login links (default: http://localhost:API_PORT)
# MM_PUBLIC_URL=https://munkymind.example.org
MCP_PORT=8001
# Ollama (local models): where the containers reach it. Default: Ollama on this computer
# OLLAMA_URL=http://host.docker.internal:11434

# Public HTTPS address for claude.ai / ChatGPT connectors (usually not needed: the server
# uses the address it was reached on). Set it if your proxy rewrites the Host header.
MCP_BASE_URL=
# Retrieval cut-off: chunks further than this (vector distance) are only returned if they also
# match the question's keywords. Default 1.3 for OpenAI embeddings; no default for other providers.
MM_MAX_DISTANCE=
